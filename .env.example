# Primary data source: Published Google Sheet CSV URL (Build time only)
# To publish: In Google Sheets, File -> Share -> Publish to web -> select sheet tab -> Comma-separated values (.csv)
# If empty, times out, or fails, the build will safely fall back to /data/fabrics.json.
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQPAKoTYr3wDqS5T__93TTAj_KabIeKiX6ObuJ61vGSEdDv7zbEMTU0TGh4GMHUvJHzAuw19fQOmJOj/pub?gid=0&single=true&output=csv

# WhatsApp contact phone number (digits with country code, e.g. 919800000000)
# Used for 1-tap inquiries on fabric cards, detail pages, and floating chat button.
NEXT_PUBLIC_WHATSAPP_NUMBER=919376132974

# Direct voice phone number (display and tel: links, e.g. +91 98000 00000)
NEXT_PUBLIC_PHONE_NUMBER=+91 93761 32974

# Optional site URL for sitemap.xml and robots.txt generation
NEXT_PUBLIC_SITE_URL=https://mmfashion.pages.dev

